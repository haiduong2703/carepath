{
  "name": "carepath-bookingcare-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/dev.ts",
    "start": "tsx --env-file-if-exists=.env scripts/serve.ts",
    "prebuild": "node scripts/prepare.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "pretypecheck": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke.test.ts --reporter=verbose",
    "test:live": "tsx --env-file-if-exists=.env scripts/check-live.ts",
    "data:refresh": "tsx scripts/ingest.ts",
    "eval:offline": "tsx scripts/evaluate.ts --offline",
    "eval:live": "tsx --env-file-if-exists=.env scripts/evaluate.ts --live"
  },
  "dependencies": {
    "@langchain/core": "^1.3.7",
    "@langchain/anthropic": "^1.6.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
